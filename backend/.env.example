OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna

# MySQL connection. Matches the Docker MySQL service defined in docker-compose.yml.
DATABASE_URL=mysql+pymysql://curiosity:curiosity@localhost:3306/curiosity?charset=utf8mb4

# First-run admin user. The app will create this account if it does not exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345

# AI pricing values in USD per 1M tokens.
PRICE_INPUT_PER_M=0.10
PRICE_CACHED_INPUT_PER_M=0.01
PRICE_OUTPUT_PER_M=0.50

# Allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173
